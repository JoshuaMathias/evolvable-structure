 {
  "id": "CTS-060",
  "area": "repo",
  "kind": "repo",
  "description": "a plugin rule reports under its own id",
  "args": {
   "edits": [
    {
     "op": "write",
     "path": "tools/my_rules.py",
     "content": "from esoi.rules.base import RuleGroup\n\n\ndef no_todo(ctx):\n    return [f\"X1 {f}: contains TODO\" for f in ctx.files if f.endswith(\".py\") and \"TODO\" in (ctx.root / f).read_text()]\n\n\nRULES = [RuleGroup({\"X1\": \"No TODO.\"}, no_todo)]\n"
    },
    {
     "op": "write",
     "path": "demo/todo.py",
     "content": "\"\"\"Todo.\"\"\"\n# TODO\n"
    },
    {
     "op": "replace",
     "path": "esoi.toml",
     "old": "package = \"demo\"",
     "new": "package = \"demo\"\nplugins = [\"tools/my_rules.py\"]"
    },
    {
     "op": "csv_cell",
     "path": "docs/structure/components.csv",
     "key_col": "component_id",
     "key": "project-files",
     "col": "path",
     "value": "*;tools/*.py"
    },
    {
     "op": "regen"
    }
   ]
  },
  "expect": {
   "rule": "X1",
   "contains": "demo/todo.py"
  }
 }
