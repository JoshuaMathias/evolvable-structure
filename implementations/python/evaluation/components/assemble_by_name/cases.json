[
 {
  "id": "ASM-001",
  "kind": "assemble",
  "area": "build order and needs injected by name",
  "description": "build order and needs injected by name",
  "args": {
   "register": [
    [
     "toy-index",
     "acme-index",
     "consumer:StoreIndex",
     false
    ],
    [
     "toy-report",
     "acme-report",
     "consumer:IndexReport",
     false
    ]
   ],
   "config": {
    "solutions": [
     "toy-report"
    ],
    "selections": {
     "toy-index": "acme-index",
     "toy-report": "acme-report"
    }
   }
  },
  "expect": {
   "eq": {
    "error": "",
    "order": [
     "toy-store",
     "toy-index",
     "toy-report"
    ],
    "built": {
     "toy-store": "Memory",
     "toy-index": "StoreIndex",
     "toy-report": "IndexReport"
    }
   }
  }
 },
