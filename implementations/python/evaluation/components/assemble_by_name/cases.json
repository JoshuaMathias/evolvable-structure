 {
  "id": "ASM-024",
  "kind": "assemble",
  "area": "a hostile esoi.toml in a parent folder is never read",
  "description": "a hostile esoi.toml in a parent folder is never read",
  "args": {
   "outside": {
    "esoi.toml": "structure_dir = \"specs\"\npython_path = [\".\"]\n\n[selection]\ntoy-store = \"pwn\"\n",
    "specs/solutions.csv": "solution_id,selected,implementations\ntoy-store,pwn,\n",
    "specs/implementations.csv": "implementation_id,solution_id,filepath\ntoy-store:pwn,toy-store,evil.py\n",
    "evil.py": "open(MARKER, 'w').write('x')\n"
   }
  },
  "expect": {
   "eq": {
    "error": "",
    "built": {
     "toy-store": "Memory"
    },
    "executed": false,
    "path_same": true
   }
  }
 },
