 {
  "id": "MSR-015",
  "area": "cost",
  "kind": "cost",
  "description": "a model run is priced from the table, per million tokens",
  "args": {
   "prices": {
    "model-x": {
     "input": 3.0,
     "output": 15.0
    }
   },
   "model": "model-x-20260101",
   "model_calls": 2,
   "tokens_in": 1000000,
   "tokens_out": 100000
  },
  "expect": {
   "eq": {
    "cost_usd": "4.5"
   }
  }
 },
 {
  "id": "MSR-016",
  "area": "cost",
  "kind": "cost",
  "description": "a model run whose model has no price records a blank cost, not zero",
  "args": {
   "prices": {
    "model-x": {
     "input": 3.0,
     "output": 15.0
    }
   },
   "model": "other",
   "model_calls": 2,
   "tokens_in": 1000,
   "tokens_out": 10
  },
  "expect": {
   "eq": {
    "cost_usd": ""
   }
  }
 },
 {
  "id": "MSR-017",
  "area": "cost",
  "kind": "cost",
  "description": "a run that called no model costs zero",
  "args": {
   "model_calls": 0
  },
  "expect": {
   "eq": {
    "cost_usd": "0.0"
   }
  }
 },
 {
  "id": "MSR-018",
  "area": "cost",
