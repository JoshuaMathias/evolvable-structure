 {
  "id": "SEL-014",
  "kind": "resolve",
  "area": "a registered implementation is selectable",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "register": [
    {
     "name": "chain",
     "target": "collections:ChainMap"
    }
   ],
   "name": "chain"
  },
  "expect": {
   "eq": {
    "resolved": "ChainMap"
   }
  },
  "description": "a registered implementation is selectable"
 },
 {
  "id": "SEL-015",
  "kind": "resolve",
  "area": "a registered default replaces the table default",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "register": [
    {
     "name": "chain",
     "target": "collections:ChainMap",
     "default": true
    }
   ]
  },
  "expect": {
   "eq": {
    "resolved": "ChainMap",
    "chosen": "chain"
   }
  },
  "description": "a registered default replaces the table default"
 },
 {
  "id": "SEL-016",
  "kind": "resolve",
  "area": "a registered name appears in the choices",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "register": [
    {
     "name": "chain",
     "target": "collections:ChainMap"
    }
   ]
  },
  "expect": {
   "eq": {
    "names": [
     "broken",
     "chain",
     "counter",
     "deque",
     "ordered"
    ]
   }
  },
  "description": "a registered name appears in the choices"
 }
