 {
  "id": "SEL-005",
  "kind": "resolve",
  "area": "an override for another solution is ignored",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "overrides": {
    "other": "deque"
   }
