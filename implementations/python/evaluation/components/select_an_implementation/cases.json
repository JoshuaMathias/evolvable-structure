    "resolved": "Counter"
   }
  },
  "description": "an override for another solution is ignored"
 },
 {
  "id": "SEL-006",
  "kind": "resolve",
  "area": "names are case-insensitive and trimmed",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "name": "  Ordered "
  },
  "expect": {
