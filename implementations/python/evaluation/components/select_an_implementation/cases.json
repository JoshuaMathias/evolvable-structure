 },
 {
  "id": "SEL-007",
  "kind": "resolve",
  "area": "an unknown name fails and lists the choices",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "name": "ordred"
  },
  "expect": {
   "eq": {
    "error": "ValueError"
   },
   "contains": [
    "ordered",
    "counter",
    "deque"
   ]
  },
  "description": "an unknown name fails and lists the choices"
 },
 {
  "id": "SEL-008",
  "kind": "resolve",
  "area": "an unknown name in an override fails too",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick",
   "overrides": {
    "pick": "nope"
   }
  },
  "expect": {
   "eq": {
    "error": "ValueError"
   },
   "contains": [
    "choices"
   ]
  },
  "description": "an unknown name in an override fails too"
 },
 {
