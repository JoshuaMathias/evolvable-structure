[
 {
  "id": "SEL-001",
  "kind": "resolve",
  "area": "default",
  "args": {
   "table": {
    "pick": {
     "default": "counter",
     "implementations": {
      "counter": "collections:Counter",
      "ordered": "collections:OrderedDict",
      "deque": {
       "target": "collections:deque",
       "config": "dataclasses:dataclass"
      },
      "broken": "no.such.module:Thing"
     }
    }
   },
   "solution": "pick"
  },
  "expect": {
   "eq": {
    "resolved": "Counter",
    "chosen": "counter",
    "names": [
     "broken",
     "counter",
     "deque",
     "ordered"
    ]
   }
  },
  "description": "default"
 },
