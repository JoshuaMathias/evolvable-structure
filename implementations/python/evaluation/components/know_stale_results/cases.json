  }
 },
 {
  "id": "STL-006",
  "area": "staleness",
  "kind": "repo",
  "description": "strict mode rejects a result recorded on uncommitted code",
  "args": {
   "edits": [
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "live",
     "col": "git_sha",
     "value": "abc1234-dirty"
    }
   ],
   "strict": true
  },
  "expect": {
   "rule": "S20",
   "contains": "uncommitted",
   "advice": true
  },
  "note": "A changed file or a missing row informs: it is advice and never fails the check."
 },
 {
  "id": "STL-007",
  "area": "staleness",
  "kind": "repo",
  "description": "a result recorded on uncommitted code is accepted outside strict mode (clean)",
  "args": {
   "edits": [
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "live",
     "col": "git_sha",
     "value": "abc1234-dirty"
    }
   ],
   "strict": false
  },
  "expect": {
   "clean": true
  }
 },
 {
  "id": "STL-008",
  "area": "staleness",
  "kind": "repo",
  "description": "strict mode rejects a result when the measured code changed since its commit",
  "args": {
   "edits": [
    {
     "op": "git_record"
    },
    {
     "op": "append",
     "path": "evaluation/components/greet_a_person/impls/live.py",
     "content": "\n# changed after the result was recorded\n"
    }
   ],
   "strict": true
  },
  "expect": {
   "rule": "S20",
   "contains": "changed since",
   "advice": true
  },
  "note": "A changed file or a missing row informs: it is advice and never fails the check."
 },
 {
  "id": "STL-009",
  "area": "staleness",
  "kind": "repo",
  "description": "a result recorded on the committed code is current under strict mode (clean)",
  "args": {
   "edits": [
    {
     "op": "git_record"
    }
   ],
   "strict": true
  },
  "expect": {
   "clean": true
  }
 },
 {
  "id": "STL-010",
  "area": "staleness",
  "kind": "repo",
  "description": "a change outside the measured code does not make a result stale (clean)",
  "args": {
   "edits": [
    {
     "op": "git_record"
    },
    {
     "op": "write",
     "path": "esoi/NOTES.md",
     "content": "notes\n"
    }
   ],
   "strict": true
  },
  "expect": {
   "clean": true
  }
 },
 {
