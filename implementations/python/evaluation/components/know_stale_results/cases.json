    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "shout",
     "col": "cases_sha",
     "value": ""
    }
   ]
  },
  "expect": {
   "rule": "S16",
   "contains": "shout"
  }
 },
 {
