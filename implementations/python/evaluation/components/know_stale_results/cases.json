[
 {
  "id": "STL-000",
  "area": "repo",
  "kind": "repo",
  "description": "clean fixture must pass",
  "args": {
   "edits": []
  },
  "expect": {
   "clean": true
  }
 },
 {
  "id": "STL-001",
  "area": "repo",
  "kind": "repo",
  "description": "selected implementation beaten in results",
  "args": {
   "edits": [
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "live",
     "col": "cases",
     "value": "40"
    },
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "live",
     "col": "passed",
     "value": "20"
    },
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "live",
     "col": "dev",
     "value": "20/40"
    },
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "shout",
     "col": "cases",
     "value": "40"
    },
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "shout",
     "col": "passed",
     "value": "40"
    },
    {
     "op": "csv_cell",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "shout",
     "col": "dev",
     "value": "40/40"
    }
   ]
  },
  "expect": {
   "rule": "S10",
   "contains": "beat the selected"
  },
  "note": "Results scaled from 2 cases to 40: under the owner's rule (Fisher's exact on aggregates, alpha 0.05) 1 of 2 vs 2 of 2 is not a significant gain, so a verdict of LOSS or a beaten-selected report needs 20/40 vs 40/40. Reviewed 2026-10-31: the rule is now highest result wins by default, significant or not, so these scaled rows still give the same outcome; the scaling is kept so the case also holds under require_significance."
 },
 {
  "id": "STL-002",
  "area": "repo",
  "kind": "repo",
  "description": "a solution with no current recorded result",
  "args": {
   "edits": [
    {
     "op": "csv_drop",
     "path": "evaluation/components/results.csv",
     "key_col": "impl",
     "key": "live"
    }
   ]
  },
  "expect": {
   "rule": "S10",
   "contains": "has no row",
   "advice": true
  },
  "note": "A changed file or a missing row informs: it is advice and never fails the check."
 },
 {
  "id": "STL-003",
  "area": "repo",
  "kind": "repo",
  "description": "a result with no cases hash",
