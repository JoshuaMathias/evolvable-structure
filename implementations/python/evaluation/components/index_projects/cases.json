[
 {
  "id": "IDX-001",
  "kind": "where",
  "area": "find",
  "args": {
   "projects": [
    {
     "id": "alpha",
     "dir": "alpha",
     "name": "Alpha",
     "vision": "Alpha serves its people well.",
     "files": {
      "CLAUDE.md": "x",
      "src/main.py": "x"
     },
     "start_here": "CLAUDE.md",
     "relations": "uses:beta"
    },
    {
     "id": "beta",
     "dir": "beta",
     "name": "Beta",
     "vision": "Beta stays reliable.",
     "files": {
      "docs/structure/network.md": "x"
     },
     "start_here": "docs/structure/network.md",
     "relations": "used-by:alpha"
    }
   ],
   "path": "alpha/src/main.py"
  },
  "expect": {
   "eq": {
    "project_id": "alpha",
    "start_here": "CLAUDE.md",
    "specifications": "esoi.toml"
   }
  },
  "description": "a file inside a listed project finds the project and where to start"
 },
